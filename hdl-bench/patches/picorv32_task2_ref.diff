diff --git a/tests/loadstore_counter.S b/tests/loadstore_counter.S
new file mode 100644
index 0000000..3b838cf
--- /dev/null
+++ b/tests/loadstore_counter.S
@@ -0,0 +1,70 @@
+# See LICENSE for license details.
+
+#*****************************************************************************
+# loadstore_counter.S
+#-----------------------------------------------------------------------------
+#
+# Test load/store instruction counter CSR 0xBC1
+#
+
+#include "riscv_test.h"
+#include "test_macros.h"
+
+RVTEST_RV32U
+.option arch, +zicsr
+RVTEST_CODE_BEGIN
+
+  # Read initial value of load/store counter
+  csrr x10, 0xBC1
+
+  # Load tdat address
+  la x1, tdat
+  
+  # Execute 3 loads
+  lw x2, 0(x1)
+  lw x3, 4(x1)
+  lh x4, 8(x1)
+
+  # Execute 2 stores
+  sw x2, 12(x1)
+  sw x3, 16(x1)
+
+  # Read counter again
+  csrr x11, 0xBC1
+  sub x12, x11, x10
+  li x13, 5
+  bne x12, x13, fail
+
+  # Execute 2 more loads
+  lb x6, 0(x1)
+  lbu x7, 1(x1)
+
+  # Execute 1 more store
+  sb x6, 20(x1)
+
+  # Read final counter value
+  csrr x14, 0xBC1
+  sub x15, x14, x11
+  li x16, 3
+  bne x15, x16, fail
+
+  RVTEST_PASS
+
+fail:
+  RVTEST_FAIL
+
+RVTEST_CODE_END
+
+  .data
+RVTEST_DATA_BEGIN
+
+tdat:
+  .word 0x12345678
+  .word 00x9ABCDEF0
+  .half 0x5678
+  .fill 20, 1, 0
+
+  TEST_DATA
+
+RVTEST_DATA_END
